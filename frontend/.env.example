# === Frontend SOC L2 Analyzer ===
# En desarrollo normalmente NO necesitas tocar esto: Vite hace proxy de /api
# al backend (http://localhost:8000). Copia a `.env` solo si quieres cambiarlo.

# Target del proxy de /api durante `npm run dev`.
VITE_API_TARGET=http://localhost:8000

# Base URL absoluta de la API (déjalo vacío para usar el proxy / mismo origen).
VITE_API_BASE_URL=
